alse" selected="false" bounds="[27,834][1440,877]" /><node index="1" text="第 1 集 · 《一屋烟火，两样人心》 第 1 集" resource-id="" class="android.widget.TextView" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[27,877][1440,909]" /><node index="2" text="#短剧  #剧情  #逆袭  #都市" resource-id="" class="android.widget.TextView" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[27,909][1440,937]" /><node index="3" text="林婉为室友做饭一年，不仅没赚钱还常倒贴，却因新人周可许诺男友免费掌勺，被逼退款停伙。免费饭很快变成收费劣质餐，室友跑腿受气，甚至吃坏肚子，才发现自己被骗。面对众人挽留，林婉晒出账单证明清白，果断搬家开档口。周可又冒用她的菜品招揽顾客，被她当众揭穿并追回退款。离开消耗自己的关系后，林婉终于有了收入、朋友与属于自己的生活。" resource-id="" class="android.widget.TextView" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[27,937][1440,984]" /><node index="4" text="" resource-id="" class="android.widget.LinearLayout" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[27,984][1440,1035]"><node index="0" text="继续播放" resource-id="" class="android.widget.Button" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[27,990][159,1035]" /><node index="1" text="下一集" resource-id="" class="android.widget.Button" package="com.hongguotv.tv" content-desc="" checkable="false" che