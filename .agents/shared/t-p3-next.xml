]" /><node index="3" text="面对相恋十年男友的背叛，姜知许只想逃离，没想到那个她一直视为弟弟的人，在她最尴尬的时候接住了她的无措“我们结婚吧，我有把握六个月内让你爱上我”，为了报复，姜知许同意了慕之景弟弟（慕子阔）的表白。闪婚后，她才发现，慕子阔居然暗恋自己多年，不仅从不会打压贬低自己，还耗尽积蓄帮自己买回当初破产被拍卖的厂房。眼看二人感情升温，姜知许的事业却突遇变故，从中作梗的人，居然是她深爱过的慕之景。" resource-id="" class="android.widget.TextView" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,590][1280,627]" /><node index="4" text="" resource-id="" class="android.widget.LinearLayout" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,627][1280,674]"><node index="0" text="继续播放" resource-id="" class="android.widget.Button" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,633][134,674]" /><node index="1" text="下一集" resource-id="" class="android.widget.Button" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="true" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[141,632][253,674]" /><node index="2" text="合集：知许不许 | 全68集 &gt;" resource-id="" class="android.widget.Button" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[260,633][469,674]" /><node index="3" text="♥ 追剧" resource-id="" class="android.widget.Button" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" foc