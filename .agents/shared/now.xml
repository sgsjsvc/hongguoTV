,549][1280,577]" /><node index="3" text="穿越到1970年的东北山村，陈昭面对饥荒与严寒，没有退缩。他凭借过硬的本领进山狩猎，从野猪到狼群，一次次为家人和乡亲带回希望。他成立狩猎队，带领村民团结互助，抵御野兽侵袭，开荒生产。在艰苦岁月里，他与刘芷若、刘芷晴姐妹相依为命，用担当和真情守护小家，也温暖了整座村庄。这是一个关于勇气、责任与奋斗的故事，展现了普通人在困境中自强不息、守望相助的精神。" resource-id="" class="android.widget.TextView" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[27,577][1280,624]" /><node index="4" text="" resource-id="" class="android.widget.LinearLayout" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[27,624][1280,675]"><node index="0" text="暂停播放" resource-id="" class="android.widget.Button" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[27,630][159,675]" /><node index="1" text="下一集" resource-id="" class="android.widget.Button" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[170,630][302,675]" /><node index="2" text="合集：重生七零，我靠狩猎带全村吃饱饭 | 全181集 &gt;" resource-id="" class="android.widget.Button" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="true" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[299,629][804,675]" /><node index="3" text="♥ 追剧" resource-id="" class="android.widget.Button" package="com.hongguotv.tv" content-desc="" checkable="false" checked="false" clickable="true" enabled=