# Android 签名配置示例
#
# 用法：
#   1. 复制本文件为 keystore.properties（同目录）
#   2. 填入实际凭据
#   3. keystore.properties 已被 .gitignore 排除，不会提交
#
# 生成新密钥（仅首次，或需要全新签名身份时）：
#   keytool -genkeypair -v \
#     -keystore "$env:USERPROFILE\.hongguotv\hongguotv-release.jks" \
#     -alias hongguotv \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -storepass <你的密码> -keypass <你的密码> \
#     -dname "CN=HongguoTV, OU=TV Client, O=HongguoTV, L=Unknown, ST=Unknown, C=CN"
#
# ⚠️ 重要：密钥一旦用于发布，必须永久保管
#   - 丢失后无法为已安装用户推送更新（签名不匹配会拒绝安装）
#   - 请离线备份 keystore 文件与密码
#   - 不要提交到版本库

# keystore 文件绝对路径（建议放在项目外）
storeFile=C:\\Users\\<用户名>\\.hongguotv\\hongguotv-release.jks

# keystore 密码
storePassword=<你的密码>

# 密钥别名
keyAlias=hongguotv

# 密钥密码（通常与 storePassword 相同）
keyPassword=<你的密码>
